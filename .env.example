# LXDOC docker-compose 环境变量
# 用法：cp .env.example .env，修改下列敏感值后 docker compose up -d
# 本文件入库作为模板；.env 不入库（已在 .gitignore）

# ===== 镜像源（可选，覆盖默认 GHCR 前缀与 tag）=====
# CI 自构建 3 个镜像：lxdoc-backend / lxdoc-frontend / lxdoc-pdf2html
# 默认从 GHCR 拉取 latest；内网部署可覆盖前缀，固定版本可覆盖 tag
# LXDOC_IMAGE_PREFIX=ghcr.io/yangzhenyu-123
# LXDOC_IMAGE_TAG=latest

# ===== PostgreSQL =====
POSTGRES_USER=lxdoc
# 生产环境务必更换为强密码
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lxdoc

# ===== Auth =====
# JWT 签名密钥，生产环境务必更换为强随机值
# 生成：openssl rand -hex 32
# 后端在 NODE_ENV=production 下会校验非默认值，使用默认值将拒绝启动
JWT_SECRET=lxdoc-dev-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# 是否允许自注册（true 开启 /api/auth/register）
ALLOW_SIGNUP=false
FILE_TOKEN_EXPIRES=10m

# ===== OnlyOffice =====
ONLYOFFICE_ENABLED=true
# OnlyOffice JWT 密钥（与 OnlyOffice 容器共享，签发 config 与校验回调）
# 生成：openssl rand -hex 32
# 生产环境（NODE_ENV=production）禁止使用默认值，否则后端拒绝启动
ONLYOFFICE_JWT_SECRET=lxdoc-onlyoffice-dev-secret

# ===== PDF 版式预览（pdf2htmlEX sidecar）=====
# docker-compose 已内置 pdf2html 服务，默认 http://pdf2html:7000，通常无需修改
# 仅在自建独立 sidecar 时覆盖；为空则后端降级为本地 PDF2HTML_BIN 二进制（需后端镜像内安装）
# PDF2HTML_URL=http://pdf2html:7000

# ===== 初始管理员（仅首次启动 users 表为空时 seed）=====
# 生产环境首次部署必须设置 ADMIN_PASSWORD，否则后端拒绝启动（防默认凭据被接管）
# ADMIN_EMAIL=admin@lxdoc.local
# ADMIN_PASSWORD=change-me-strong-password

# ===== CORS（可选）=====
# 默认不开启跨域（生产同源部署）。如需跨域访问后端 API，配置允许的来源白名单（逗号分隔）
# CORS_ORIGINS=https://lxdoc.example.com,http://localhost:5173

# ===== API 调试文档（Swagger UI）=====
# 生产环境默认关闭（防接口结构泄露），需调试时显式开启；开发环境默认开启
# 开启后访问 http://localhost:8080/api/docs
# ENABLE_API_DOCS=true

# ===== LLM（默认关闭，待内网 GLM5.2 接入时开启）=====
# LLM_ENABLED=true 时启用 RAG 问答与示例问题生成
LLM_ENABLED=false
LLM_BASE_URL=http://internal-glm/v1
LLM_API_KEY=
LLM_MODEL=glm-5.2

# ----- Embedding 服务（RAG 知识库向量检索必需）-----
# 用 TEI 部署 BAAI/bge-m3（CPU 版，1024 维）；LLM_ENABLED=true 时若未配置则创建知识库会失败
# 部署 TEI：docker run -d --name tei-embed -p 8081:80 -v tei-embed:/data \
#   ghcr.io/huggingface/text-embeddings-inference:cpu-1.5 --model-id BAAI/bge-m3
LLM_EMBED_BASE_URL=
LLM_EMBED_MODEL=
LLM_EMBED_DIMENSIONS=0

# ----- Rerank 服务（可选，未配置时 RAG 自动回退纯 RRF）-----
# 用 TEI 部署 BAAI/bge-reranker-v2-m3（cross-encoder 二次精排，提升检索相关性）
# 部署 TEI：docker run -d --name tei-rerank -p 8082:80 -v tei-rerank:/data \
#   ghcr.io/huggingface/text-embeddings-inference:cpu-1.5 --model-id BAAI/bge-reranker-v2-m3
LLM_RERANK_BASE_URL=
LLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LLM_RERANK_CANDIDATE_K=20

# ----- LLM 调用参数（可选，有默认值）-----
# LLM_TIMEOUT=30000
# LLM_MAX_RETRIES=2
# LLM_SUMMARY_MAX_CHARS=80000

# ----- Vision（多模态，可选）-----
# 含图片的文档总结 / RAG 问答时自动切到 vision 模型识图。
# 留空 LLM_VISION_MODEL 则禁用 vision，含图文档回退到默认模型（仅文本，图片被忽略 + warn）。
# 与 GLM5.2 同 OpenAI 兼容接口的 vision 模型示例：qwen3.6-35b-a3b
# 若 vision 模型与默认模型同端点，仅需配 LLM_VISION_MODEL，BASE_URL/API_KEY 留空复用默认
# LLM_VISION_MODEL=qwen3.6-35b-a3b
# LLM_VISION_BASE_URL=
# LLM_VISION_API_KEY=
# LLM_VISION_MAX_IMAGES=5
# LLM_VISION_MAX_IMAGE_BYTES=2097152

# ===== docling-serve 统一文档解析（默认关闭）=====
# 启用后上传 docx/odt/pdf 优先走 docling，支持 PDF 图片/表格/版式/OCR；
# docling sidecar 故障自动回退 pandoc/pdf-parse，不阻断上传
# docker-compose 已内置 docling sidecar（cpu-latest 镜像，首次启动下载约 2GB 模型）
DOCLING_ENABLED=false
DOCLING_URL=http://docling:5001
DOCLING_API_KEY=
# OCR 仅扫描件/图片型 PDF 需要，CPU 模式吃内存（sidecar 需 4g+）
DOCLING_DO_OCR=false
