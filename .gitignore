# 依赖目录
node_modules/

# pnpm-workspace.yaml 需入库：Docker 构建依赖其中的 allowBuilds 白名单
# （pnpm 11 默认阻止依赖执行 install 脚本，须在 install 前提供此配置）

# 上传文件目录（容器挂载用，不入库）
uploads/original/
uploads/images/
uploads/cache/
uploads/attachments/

# 环境变量
.env

# 构建产物
dist/

# Vditor 静态资源：构建时从 node_modules/vditor/dist 复制到 public/vditor，
# 用于本地化 Vditor 的 i18n/emoji 资源（默认从 unpkg CDN 加载，内网不可用）
web/public/vditor/

# 日志
*.log

# 系统文件
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Trae AI 助手本地工作目录（specs/tasks 等过程产物，不入库）
.trae/
__pycache__/
*.pyc
selftest/

# 备份产物（backup 容器定时生成，不入库）
backups/

# 配置文件临时备份（开发时手动 cp 生成，不入库）
*.bak.*
*.bak

# opencode/agent 系统临时目录
.clawhub/

# RAG 调研参考项目源码（开发时 clone 用于调研，不入库）
CowAgent/
MimirQ/
PandaWiki/
WeKnora/
Yuxi/
langgraph/
ragflow/
zgi/

