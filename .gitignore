# 依赖目录
node_modules/

# pnpm 11 会自动生成 pnpm-workspace.yaml 记录 allowBuilds 配置，
# 但本项目非 monorepo，该文件会导致容器内 pnpm 9 误判为 workspace 报错，故忽略
pnpm-workspace.yaml

# 上传文件目录（容器挂载用，不入库）
uploads/original/
uploads/images/
uploads/cache/
uploads/attachments/

# 环境变量
.env

# 构建产物
dist/

# Vditor 静态资源：构建时从 node_modules/vditor/dist 复制到 public/vditor，
# 用于本地化 Vditor 的 i18n/emoji 资源（默认从 unpkg CDN 加载，内网不可用）
web/public/vditor/

# 日志
*.log

# 系统文件
.DS_Store

# IDE
.idea/
.vscode/

# Trae AI 助手本地工作目录（specs/tasks 等过程产物，不入库）
.trae/
__pycache__/
*.pyc
selftest/

# 备份产物（backup 容器定时生成，不入库）
backups/

# opencode/agent 系统临时目录
.clawhub/
