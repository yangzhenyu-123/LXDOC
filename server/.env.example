# 后端服务端口
PORT=3000

# PostgreSQL 连接配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=lxdoc
DB_PASS=lxdoc
DB_NAME=lxdoc

# 上传文件存储根目录
UPLOAD_DIR=/app/uploads

# Auth
# JWT 签名密钥，生产环境务必更换为强随机值
JWT_SECRET=lxdoc-dev-secret-change-me
# Access Token 有效期（15 分钟）
JWT_ACCESS_EXPIRES=15m
# Refresh Token 有效期（7 天）
JWT_REFRESH_EXPIRES=7d
# 是否允许自注册（true 开启 /api/auth/register，false 关闭返回 403）
ALLOW_SIGNUP=false
