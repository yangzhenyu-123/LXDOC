# 后端服务端口
PORT=3000

# PostgreSQL 连接配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=lxdoc
DB_PASS=lxdoc
DB_NAME=lxdoc

# 上传文件存储根目录
UPLOAD_DIR=/app/uploads

# Auth
# JWT 签名密钥，生产环境务必更换为强随机值
JWT_SECRET=lxdoc-dev-secret-change-me
# Access Token 有效期（15 分钟）
JWT_ACCESS_EXPIRES=15m
# Refresh Token 有效期（7 天）
JWT_REFRESH_EXPIRES=7d
# 是否允许自注册（true 开启 /api/auth/register，false 关闭返回 403）
ALLOW_SIGNUP=false
# 静态文件签名 token 有效期（<img src>/pdfjs 等无法带 Authorization 头的场景）
FILE_TOKEN_EXPIRES=10m

# OnlyOffice Document Server（docx/odt 原格式编辑）
# 是否启用 OnlyOffice（false 时前端走 pandoc 预览降级，无编辑能力）
ONLYOFFICE_ENABLED=true
# OnlyOffice 容器内部地址（后端用于拼接 fileUrl，需 OnlyOffice 容器可达）
ONLYOFFICE_URL=http://onlyoffice
# 浏览器可访问的 OnlyOffice 地址（前端 api.js 加载来源，通常同源反代 /onlyoffice）
ONLYOFFICE_PUBLIC_URL=/onlyoffice
# OnlyOffice 回调后端的地址（需 OnlyOffice 容器可达后端）
BACKEND_PUBLIC_URL=http://backend:3000
# OnlyOffice JWT 密钥（与 OnlyOffice 容器 JWT_SECRET 共享，签发 config 与校验回调）
# 未配置时回退到 JWT_SECRET
ONLYOFFICE_JWT_SECRET=lxdoc-onlyoffice-dev-secret

# PDF 工具（系统二进制，Docker 镜像内安装）
# pdf2htmlEX 路径（生成版式保真 HTML）
PDF2HTML_BIN=pdf2htmlEX
# LibreOffice soffice 路径（PDF→docx 转换）
SOFFICE_BIN=soffice

# LLM 接入（内网 GLM5.2，本期仅骨架）
# 是否启用 LLM（false 时 LlmService.chat/embed 返回 null，业务降级）
LLM_ENABLED=false
# 内网 GLM OpenAI 兼容端点
LLM_BASE_URL=http://internal-glm/v1
# 调用密钥（内网若无需鉴权可留空）
LLM_API_KEY=
# 默认对话模型
LLM_MODEL=glm-5.2
# 向量模型（内网若不提供 embedding 则留空，RAG 向量检索自动禁用）
LLM_EMBED_MODEL=
# 向量维度（与 pgvector 列定义对齐，0 表示未启用）
LLM_EMBED_DIMENSIONS=0
# 单次请求超时（毫秒）
LLM_TIMEOUT=30000
# 最大重试次数（指数退避）
LLM_MAX_RETRIES=2
