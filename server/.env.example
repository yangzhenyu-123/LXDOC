# 后端服务端口
PORT=3000

# PostgreSQL 连接配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=lxdoc
DB_NAME=lxdoc

# ============================================================
# 以下敏感配置项用于 docker-compose（项目根目录 .env）
# 开发时本文件供 server 本地运行使用，敏感值可留默认（仅本地）
# ============================================================

# 数据库密码（生产环境务必更换）
POSTGRES_USER=lxdoc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lxdoc

# Auth
# JWT 签名密钥，生产环境务必更换为强随机值（建议 >= 32 字节，如 openssl rand -hex 32）
# 后端在 NODE_ENV=production 下会校验非默认值，使用默认值将拒绝启动
JWT_SECRET=lxdoc-dev-secret-change-me
# Access Token 有效期（15 分钟）
JWT_ACCESS_EXPIRES=15m
# Refresh Token 有效期（7 天）
JWT_REFRESH_EXPIRES=7d
# 是否允许自注册（true 开启 /api/auth/register，false 关闭返回 403）
ALLOW_SIGNUP=false
# 静态文件签名 token 有效期（<img src>/pdfjs 等无法带 Authorization 头的场景）
FILE_TOKEN_EXPIRES=10m

# OnlyOffice Document Server（docx/odt 原格式编辑）
# 是否启用 OnlyOffice（false 时前端走 pandoc 预览降级，无编辑能力）
ONLYOFFICE_ENABLED=true
# OnlyOffice 容器内部地址（后端用于拼接 fileUrl，需 OnlyOffice 容器可达）
ONLYOFFICE_URL=http://onlyoffice
# 浏览器可访问的 OnlyOffice 地址（前端 api.js 加载来源，通常同源反代 /onlyoffice）
ONLYOFFICE_PUBLIC_URL=/onlyoffice
# OnlyOffice 回调后端的地址（需 OnlyOffice 容器可达后端）
BACKEND_PUBLIC_URL=http://backend:3000
# OnlyOffice JWT 密钥（与 OnlyOffice 容器 JWT_SECRET 共享，签发 config 与校验回调）
# 生产环境（NODE_ENV=production）禁止使用默认值，否则后端拒绝启动
ONLYOFFICE_JWT_SECRET=lxdoc-onlyoffice-dev-secret

# 初始管理员（仅首次启动 users 表为空时 seed）
# 生产环境首次部署必须设置 ADMIN_PASSWORD，否则后端拒绝启动（防默认凭据被接管）
# ADMIN_EMAIL=admin@lxdoc.local
# ADMIN_PASSWORD=change-me-strong-password

# CORS（可选）：默认不开启跨域。如需跨域访问后端 API，配置允许来源白名单（逗号分隔）
# CORS_ORIGINS=https://lxdoc.example.com,http://localhost:5173

# PDF 工具
# pdf2htmlEX sidecar HTTP 地址（生产：docker-compose 内置 pdf2html 服务）
# 为空则降级为本地 PDF2HTML_BIN 二进制（仅开发环境，需本机装 pdf2htmlEX）
PDF2HTML_URL=http://pdf2html:7000
# 本地 pdf2htmlEX 二进制路径（仅 PDF2HTML_URL 为空时使用，开发降级）
PDF2HTML_BIN=pdf2htmlEX
# LibreOffice soffice 路径（PDF→docx 转换，仍在后端镜像内本地执行）
SOFFICE_BIN=soffice

# LLM 接入（内网 GLM5.2，本期仅骨架）
# 是否启用 LLM（false 时 LlmService.chat/embed 返回 null，业务降级）
LLM_ENABLED=false
# 内网 GLM OpenAI 兼容端点
LLM_BASE_URL=http://internal-glm/v1
# 调用密钥（内网若无需鉴权可留空）
LLM_API_KEY=
# 默认对话模型
LLM_MODEL=glm-5.2
# 向量模型（内网若不提供 embedding 则留空，RAG 向量检索自动禁用）
LLM_EMBED_MODEL=
# 向量维度（与 pgvector 列定义对齐，0 表示未启用）
LLM_EMBED_DIMENSIONS=0
# 单次请求超时（毫秒）
LLM_TIMEOUT=30000
# 最大重试次数（指数退避）
LLM_MAX_RETRIES=2
# 总结单次投喂文本上限（字符数）。超过则截断头尾各半保留，避免超出模型上下文窗口
LLM_SUMMARY_MAX_CHARS=80000
