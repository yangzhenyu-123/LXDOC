# LXDOC 后端镜像：基于 node:22-bookworm-slim
# Node 22 + pnpm 11.6 与开发环境一致（pnpm 11 需 Node 22+，且 pnpm-workspace.yaml 用了 11+ 的 allowBuilds 字段）
# 系统依赖：
# - pandoc：docx/odt → markdown/html 抽取，PDF 转 markdown 中间步骤
# - pdf2htmlEX：PDF → 版式保真 HTML（仅 Debian sid/unstable 可装；stable 用源码或换镜像）
# - libreoffice（soffice）：PDF → docx 转换，用于 PDF 转可编辑
# - poppler-utils：PDF 元信息辅助工具
FROM node:22-bookworm-slim

# 安装系统依赖
# 注：pdf2htmlEX 在 Debian stable 仓库不可用，需自行构建或换用第三方镜像
# 此处先装 pandoc/libreoffice/poppler-utils，pdf2htmlEX 缺失时 PDF 版式预览功能降级（错误提示）
# 部署时若需启用 PDF 版式预览，请在镜像构建时加装 pdf2htmlEX 或单独构建衍生镜像
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        pandoc \
        libreoffice \
        poppler-utils \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 固定 pnpm 版本（通过 corepack），保证构建可复现
# 注意：须与开发机 pnpm 版本一致，避免 pnpm-workspace.yaml 新字段（如 allowBuilds）兼容性问题
ENV PNPM_HOME=/usr/local/share/pnpm
ENV PNPM_VERSION=11.6.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# 先拷贝依赖清单 + pnpm-workspace.yaml（含 allowBuilds 构建白名单），利用 Docker 层缓存
# 注意：pnpm 11 默认阻止依赖执行 install 脚本，须在 install 前提供 pnpm-workspace.yaml 的 allowBuilds 配置
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./

# 安装依赖（含 devDependencies，构建期需要 nest/cli）
RUN pnpm install --prod=false --frozen-lockfile || pnpm install --prod=false

# 拷贝源码
COPY . .

# 构建产物到 dist/
RUN pnpm build

ENV UPLOAD_DIR=/app/uploads
ENV NODE_ENV=production

# uploads 目录需可被 node 用户写入
RUN mkdir -p /app/uploads && chown -R node:node /app
USER node

EXPOSE 3000

# 健康检查：探测 /health（controller 已 exclude 全局前缀，路径为 /health）
# 用 node 内置 http 模块，无需额外安装 curl/wget，保持镜像精简
# 注意：docker-compose 中的 healthcheck 会覆盖此处，二者保持一致便于独立 docker run
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# 运行编译后的入口
CMD ["node", "dist/main.js"]
