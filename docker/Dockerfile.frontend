# LXDOC 前端镜像：多阶段构建
# 构建上下文为项目根目录（docker-compose.yml 的 context: .），
# 故 COPY 路径需带 web/ 与 docker/ 前缀以访问对应子目录。
#
# 兼容性说明：此前用 docker-compose additional_contexts 注入 docker 上下文，
# 但该特性依赖 BuildKit/buildx，docker 18.09 经典 builder 不支持；
# 改为以项目根为构建上下文，无需 additional_contexts，兼容更广。
#
# Stage 1: 构建 Vue3 静态资源
FROM node:20-alpine AS builder

WORKDIR /app

# 固定 pnpm 版本（通过 corepack），保证构建可复现
ENV PNPM_VERSION=9.12.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# 依赖清单从 web/ 子目录拷贝（构建上下文为项目根）
COPY web/package.json web/pnpm-lock.yaml* ./
RUN pnpm install --prod=false --frozen-lockfile || pnpm install --prod=false

# 拷贝前端源码并构建
COPY web/ .

# 将 vditor 静态资源复制到 public/vditor，供 Vditor 运行时从本地 /vditor/dist/... 加载
# （Vditor 默认从 unpkg.com CDN 加载 i18n/emoji 等，内网无法访问外网）
# vite build 会自动把 public/ 目录内容拷贝到 dist 根，故 public/vditor/dist → /vditor/dist
# 注意：必须拷贝 dist 目录本身（保留 dist 层），而非 dist/*（会把内容摊到 vditor/ 下，
#       导致 Vditor cdn:'/vditor' 请求 /vditor/dist/js/i18n/zh_CN.js 时 404）
RUN mkdir -p public/vditor && cp -r node_modules/vditor/dist public/vditor/

# 将 pdfjs-dist 的 cMap 文件复制到 public/pdfjs-cmaps，供 pdfjs 按需加载中文 CID 字体映射
# 不配置 cMapUrl 时，含中文的 PDF 用 pdfjs canvas 渲染会出现中文字不显示（文字消失）
# vite build 会把 public/pdfjs-cmaps 拷贝到 dist/pdfjs-cmaps，nginx 静态托管
RUN mkdir -p public/pdfjs-cmaps && cp -r node_modules/pdfjs-dist/cmaps/. public/pdfjs-cmaps/

RUN pnpm build

# Stage 2: nginx 托管 dist/，并反代 /api 到后端
# 固定版本标签，避免 :latest 不可预期的升级引入 breaking change
FROM nginx:1.27-alpine

# 拷贝构建产物到 nginx 静态目录
COPY --from=builder /app/dist /usr/share/nginx/html

# vite build 默认 umask 生成 640 权限文件，nginx worker 以 nginx 用户运行无法读取 root 拥有的文件，
# 需放开为 644/755 确保 nginx 可读（仅容器内，无安全风险）
RUN chmod -R a+rX /usr/share/nginx/html

# 用自定义 nginx.conf 替换默认配置（构建上下文为项目根，直接从 docker/ 拷贝）
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
