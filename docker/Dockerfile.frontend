# LXDOC 前端镜像：多阶段构建
# Stage 1: 构建 Vue3 静态资源
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
RUN npm install -g pnpm && pnpm install --prod=false

COPY . .
RUN pnpm build

# Stage 2: nginx 托管 dist/，并反代 /api、/uploads 到后端
FROM nginx:alpine

# 拷贝构建产物到 nginx 静态目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 用自定义 nginx.conf 替换默认配置
# 通过 docker-compose additional_contexts 注入 docker 上下文（构建上下文为 ./web，
# 无法直接访问 ../docker，故用命名上下文 docker 引入 nginx.conf）
COPY --from=docker nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
